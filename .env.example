# ── Server-only (never NEXT_PUBLIC_) ─────────────────────────────
# Restricted by IP to the VPS (+ dev IPs). APIs: Solar (+ Geocoding only if you add a server-side fallback).
SOLAR_API_KEY=
# Where roof data comes from (docs/INFRA.md → Data sources):
#   fixtures = never call Google. Serve cached real responses (≤ max age) + fixtures/synthetic/. Dev, CI, demo fallback.
#   cache    = serve a cached response if one matches; otherwise call Google ONCE and save it. The VPS.
#   live     = call Google for every new roof; in-memory cache only, nothing on disk.
SOLAR_SOURCE=fixtures
# Disk cache for real Google responses. Gitignored and dockerignored; on the VPS it's ~/solmap-ops/solar-cache.
SOLAR_CACHE_DIR=fixtures/solar
# Cached Google responses older than this are ignored and deleted. Google allows ≤ 30 days; never set above 29.
SOLAR_CACHE_MAX_AGE_DAYS=25
# 1 = on a 404, retry once with experiments=EXPANDED_COVERAGE&requiredQuality=BASE (pre-GA). Off unless the pre-event test showed it helps in BC.
SOLAR_EXPANDED_COVERAGE=0
# On the VPS this file is ~/solmap-ops/.env. Optional there: SOLMAP_TAG=sha-<7> pins the image (rollback / demo freeze).
# In-memory cache TTL in front of the disk cache (process memory only)
SOLAR_CACHE_TTL_SECONDS=900
# Simple per-IP limit on /api/solar/*
RATE_LIMIT_PER_MINUTE=30

# ── Browser (baked in at build time) ─────────────────────────────
# Restricted by HTTP referrer. APIs: Maps JavaScript, Places (New).
NEXT_PUBLIC_MAPS_API_KEY=
NEXT_PUBLIC_MAP_ID=

# ── P2 only ──────────────────────────────────────────────────────
# DATABASE_URL=postgres://solmap:***@db:5432/solmap
# ANTHROPIC_API_KEY=   # LLM plain-language summary (P2)
