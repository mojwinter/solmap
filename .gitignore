# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Append to the Next.js .gitignore
.env*
!.env.example
# Disk cache of real Google Solar responses (SOLAR_CACHE_DIR). Auto-deleted at 25 days (Google terms: 30). Never commit.
# Committed fixtures live in fixtures/synthetic/ (hand-made, not Google content).
fixtures/solar/
ops/solar-cache/
# Personal Claude Code settings (the shared ones are .claude/settings.json)
.claude/settings.local.json
