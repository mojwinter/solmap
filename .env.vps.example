# /srv/solmap/.env  (read by docker compose for Caddy)
PROD_DOMAIN=solmap.example.com
STAGING_DOMAIN=staging.solmap.example.com
STAGING_USER=team
# bcrypt hash from: docker run --rm caddy:2 caddy hash-password --plaintext 'yourpass'
# Keep the SINGLE quotes: the hash contains $ signs, and compose interpolates unquoted or double-quoted values.
STAGING_PASS_HASH='$2a$14$replace-me'
# /srv/solmap/.env.prod and .env.staging each hold a copy of .env.example with real values
